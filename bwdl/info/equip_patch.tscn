[connection signal="pressed" from="create/武器" to="." method="set_equip_type" binds= [ "武器" ]]
[connection signal="pressed" from="create/防具" to="." method="set_equip_type" binds= [ "防具" ]]
[connection signal="pressed" from="create/道具" to="." method="set_equip_type" binds= [ "道具" ]]
[connection signal="pressed" from="create/坐骑" to="." method="set_equip_type" binds= [ "坐骑" ]]
[connection signal="pressed" from="create/save" to="." method="create_detail"]
[connection signal="pressed" from="create/close" to="." method="close_patch"]
[connection signal="pressed" from="detail/random" to="." method="random_weapon"]
[connection signal="pressed" from="detail/features/btn0" to="." method="change_feature" binds= [ 0 ]]
[connection signal="pressed" from="detail/features/btn1" to="." method="change_feature" binds= [ 1 ]]
[connection signal="pressed" from="detail/features/btn2" to="." method="change_feature" binds= [ 2 ]]
