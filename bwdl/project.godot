"deadzone": 0.5,
"events": [  ]
}
ANALOG_DOWN={
"deadzone": 0.5,
"events": [  ]
}
ANALOG_LEFT={
"deadzone": 0.5,
"events": [  ]
}
ANALOG_RIGHT={
"deadzone": 0.5,
"events": [  ]
}
EMU_START={
"deadzone": 0.5,
"events": [  ]
}
EMU_SELECT={
"deadzone": 0.5,
"events": [  ]
}
EMU_A={
"deadzone": 0.5,
"events": [  ]
}
EMU_B={
"deadzone": 0.5,
"events": [  ]
}
EMU_SPEED_DOWN={
"deadzone": 0.5,
