[application]

config/name="Sgz Bwddl"
run/main_scene="res://scene/Main.tscn"
run/low_processor_mode=true
run/delta_sync_after_draw=true
run/delta_smoothing=false
boot_splash/show_image=false
boot_splash/image="res://start_img.png"
boot_splash/fullsize=false
boot_splash/use_filter=false
boot_splash/bg_color=Color( 0.141176, 0.141176, 0.141176, 1 )
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[autoload]

SkillInfo="*res://info/skill_info.gd"
clAes="*res://script/objects/clAES.gd"
AutoLoad="*res://script/AutoLoad.gd"
Global="*res://script/global.gd"
StaticManager="*res://script/Static_Manager.gd"
DataManager="*res://script/Data_Manager.gd"
SkillHelper="*res://script/skill_system/Skill_Helper.gd"
LoadControl="*res://script/Load_Control.gd"
SoundManager="*res://scene/manager/Sound_Manager.tscn"
SceneManager="*res://scene/manager/Scene_Manager.tscn"
ActorHelper="*res://script/Actor_Helper.gd"
FlowManager="*res://script/Flow_Manager.gd"
ItemHelper="*res://script/ItemHelper.gd"
EndlessGame="*res://script/clEndlessGame.gd"
OrderHistory="*res://script/objects/OrderHistory.gd"
CloudSave="*res://script/Cloud_Save.gd"

[debug]

settings/fps/force_fps=60
gdscript/warnings/enable=false
shapes/collision/draw_2d_outlines=false

[display]

window/size/test_width=256
window/size/test_height=150
window/dpi/allow_hidpi=true
window/vsync/use_vsync=false
window/stretch/mode="2d"
window/stretch/aspect="keep"

[global]

android=false
export=false
locale=false
font=false
rcedit=true

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/custom_font="res://resource/font/FandolSong-Bold/18.tres"

[importer_defaults]

texture={
"flags/filter": false,
"flags/mipmaps": true
}

[input]

ui_left={
"deadzone": 0.5,
"events": [  ]
}
ui_right={
"deadzone": 0.5,
"events": [  ]
}
ui_up={
"deadzone": 0.5,
"events": [  ]
