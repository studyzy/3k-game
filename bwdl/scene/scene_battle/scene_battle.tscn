[sub_resource type="Shader" id=5]
code = "shader_type canvas_item;

// 聚焦区域的中心位置（标准化坐标，0-1）
uniform vec2 focus_center;
// 聚焦区域的大小（标准化尺寸，0-1）  
uniform vec2 focus_size;
// 边缘羽化程度
uniform float feather_amount;

void fragment() {
    // 计算当前像素到聚焦区域边缘的距离
    vec2 dist = abs(UV - focus_center) - focus_size * 0.5;
    float max_dist = max(dist.x, dist.y);
    
    // 使用平滑步长创建羽化边缘
    float alpha = smoothstep(0.0, feather_amount, max_dist);
    
    // 输出颜色：灰色背景，聚焦区域完全透明
    COLOR = vec4(0.2, 0.2, 0.2, alpha * 0.7);
}"

[sub_resource type="ShaderMaterial" id=6]
