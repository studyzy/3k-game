[sub_resource type="Shader" id=5]
code = "shader_type canvas_item;

void fragment() {
    // 获取输入颜色
    vec4 color = texture(SCREEN_TEXTURE, SCREEN_UV);
    // 计算灰度值
    float gray = dot(color.rgb, vec3(0.299, 0.587, 0.114));
    // 输出灰度颜色
    color.rgb = vec3(gray);
    // 设置颜色
    COLOR = color;
}
"

