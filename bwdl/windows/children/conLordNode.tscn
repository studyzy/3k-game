[sub_resource type="Shader" id=2]
code = "shader_type canvas_item;
render_mode unshaded;

//边框色
uniform vec3 outline_color_rgb = vec3(0,0,0);
//内图色
uniform vec3 inside_color_rgb = vec3(1,1,0.2);
//透明度
uniform float alpha = 1.0;

void fragment(){
	COLOR = texture(TEXTURE,UV);
	if (COLOR.a > 0.1) {
		//边框
		if (COLOR.r <= float(1) && COLOR.r >=float(0.5)) {
			COLOR.rgb = outline_color_rgb;
			COLOR.a = alpha;
		} else {
			COLOR.rgb = inside_color_rgb;
			COLOR.a = alpha;
		}
	}
}"

