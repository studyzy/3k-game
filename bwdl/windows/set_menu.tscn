[sub_resource type="GDScript" id=1]
script/source = "extends Control

onready var save_lord = get_node(\"save_lord\");
onready var set_game = get_node(\"set_game\");
onready var lsc = get_node(\"Control/lsc\");



func _ready() -> void:
	change_show(false);
	pass

func change_show(b:bool):
	if(b):
		if(\"scene_net\" in SceneManager.current_scene_path):
			b = false;
		if(AutoLoad.get_local_id()!=1):
			b = false;
			var lblspeed = SceneManager.VirtualKey.get_node(\"lblspeed\");
			lblspeed.show();
			SceneManager.VirtualKey.lblspeed_show_time = 300;
			lblspeed.text = \"联机过程只有1P可用菜单键\";
	SceneManager.pause(b);
	visible = b;
	
	set_process(b);
	lsc.cursor_index = 0;
	save_lord.hide();
	set_game.hide();

func _process(delta: float) -> void:
	if(SceneManager.dialog.visible):
		return;
	if(save_lord.visible):
		save_lord.input_key();
		return;
	if(set_game.visible):
		set_game.input_key();
		return;
	if(Input.is_action_just_pressed(\"ANALOG_UP\")):
		lsc.move_up()
	if(Input.is_action_just_pressed(\"ANALOG_DOWN\")):
		lsc.move_down()
	if(Input.is_action_just_pressed(\"EMU_A\")):
		match get_cursor_name():
			\"返回游戏\":
				change_show(false);
			\"退出游戏\":
				get_tree().quit();
			\"保存游戏\":
				save_lord.init_data(true);
				save_lord.show();
			\"读取游戏\":
				save_lord.init_data(false);
				save_lord.show();
			\"标题画面\":
				SceneManager.restart();
				change_show(false);
			\"其他设置\":
				set_game.init_set();
				set_game.show();
	if(Input.is_action_just_pressed(\"EMU_B\")):
		Input.action_release(\"EMU_B\");
		change_show(false);
	
	pass

func get_cursor_name()->String:
	return str(lsc.items[lsc.cursor_index]);
"

